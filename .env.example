# ─────────────────────────────────────────────────────────────────────────────
# NSE-MCX-Trends Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=trading_db
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=change_me_strong_password_123
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ─── Apache Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
KAFKA_GROUP_ID=nse-mcx-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_TOPIC_MARKET_DATA=market-data
KAFKA_TOPIC_TRADE_SIGNALS=trade-signals
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_OPTION_CHAIN=option-chain
KAFKA_TOPIC_INSTRUMENT_UPDATES=instrument-updates

# ─── Ollama (Local LLM) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2
OLLAMA_MEMORY_LIMIT=6g
# Alternative models: llama3.1, mistral, gemma2:9b, phi3:medium
OLLAMA_FALLBACK_MODEL=phi3:medium

# ─── Zerodha Kite Connect ─────────────────────────────────────────────────────
# Register at: https://kite.trade/
BROKER_ZERODHA_API_KEY=your_zerodha_api_key_here
BROKER_ZERODHA_API_SECRET=your_zerodha_api_secret_here
BROKER_ZERODHA_ACCESS_TOKEN=your_zerodha_access_token_here
BROKER_ZERODHA_USER_ID=your_zerodha_user_id
# Access token needs daily refresh after login
BROKER_ZERODHA_REQUEST_TOKEN=

# ─── AliceBlue ANT API ────────────────────────────────────────────────────────
# Register at: https://ant.aliceblueonline.com/
BROKER_ALICEBLUE_API_KEY=your_aliceblue_api_key_here
BROKER_ALICEBLUE_USER_ID=your_aliceblue_user_id_here
BROKER_ALICEBLUE_API_SECRET=your_aliceblue_api_secret_here
BROKER_ALICEBLUE_SESSION_ID=

# ─── Bonanza Portfolio ────────────────────────────────────────────────────────
# Register at: https://www.bonanzaonline.com/
BROKER_BONANZA_API_KEY=your_bonanza_api_key_here
BROKER_BONANZA_API_SECRET=your_bonanza_api_secret_here
BROKER_BONANZA_USER_ID=your_bonanza_user_id_here
BROKER_BONANZA_CLIENT_CODE=

# ─── Yahoo Finance ────────────────────────────────────────────────────────────
# Get key at: https://rapidapi.com/apidojo/api/yahoo-finance1
YAHOO_FINANCE_API_KEY=your_yahoo_finance_api_key_here
YAHOO_FINANCE_API_HOST=apidojo-yahoo-finance-v1.p.rapidapi.com
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# ─── NSE India Data API ───────────────────────────────────────────────────────
NSE_DATA_API_URL=https://www.nseindia.com/api
NSE_DATA_COOKIES=
MCX_DATA_API_URL=https://www.mcxindia.com/api

# ─── Security / JWT ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_very_long_random_string_at_least_64_chars_long_for_security
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Application Ports ───────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000
PGADMIN_PORT=5050

# ─── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@trading.local
PGADMIN_PASSWORD=pgadmin_secret

# ─── JVM Options ─────────────────────────────────────────────────────────────
# Virtual threads (Loom) + container awareness + preview features
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseZGC -Djava.net.preferIPv4Stack=true -Dspring.threads.virtual.enabled=true

# ─── Spring Boot Profile ─────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# ─── Email / Alerts (Optional) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_FROM=noreply@trading.local
ALERT_EMAIL_TO=your_email@gmail.com

# ─── Telegram Bot (Optional) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Monitoring (Optional) ───────────────────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=grafana_secret
PROMETHEUS_PORT=9090
